{
  // npm run typecheck: the score server (Node) and the pure rules it imports.
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": false,
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "types": ["node"], "skipLibCheck": true
  },
  "include": ["server/**/*.mjs"]
}
