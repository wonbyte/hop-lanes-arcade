{
  "name": "hop-lanes",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "description": "Hop Lanes arcade game",
  "scripts": {
    "check": "for f in js/*.js server/*.mjs tests/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "npm run check && npm run lint && node tests/rules.test.mjs && node tests/replay.test.mjs && node tests/sim.test.mjs && node tests/gen.test.mjs && node tests/property.test.mjs && node tests/smoke.test.mjs && node tests/layout.test.mjs && node tests/ui.test.mjs && node tests/scores-server.test.mjs",
    "build": "./tools/build-standalone.sh",
    "scores": "node server/scores.mjs",
    "icons": "python3 tools/make-icons.py",
    "build:three": "node tools/build-three.mjs",
    "lint": "eslint . --max-warnings 0 && node tools/check-exports.mjs",
    "test:property": "PROP_RUNS=20 node tests/property.test.mjs",
    "mutate": "stryker run",
    "fuzz": "node tools/fuzz-replay.mjs --seconds 300",
    "profile": "node tools/profile-game.mjs",
    "load": "node tools/load-server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "deps": "depcruise js server --config .dependency-cruiser.cjs",
    "dupes": "jscpd --config .jscpd.json",
    "scan": "./tools/security-scan.sh"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "autocannon": "8.0.0",
    "csp_evaluator": "1.1.8",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-security": "3.0.1",
    "fast-check": "3.23.2",
    "jscpd": "5.3.3",
    "playwright": "1.56.1",
    "spectorjs": "0.9.30",
    "three": "0.186.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "overrides": {
    "uuid": "11.1.1",
    "qs": "6.16.0"
  }
}
